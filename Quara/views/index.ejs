<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Posts</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>All Posts</h1>
    <div class="posts">
        <% posts.forEach(function(post) { %>
            <div class="post">
                <h2><%= post.author %></h2>
                <p><%= post.content %></p>
                <a href="/posts/<%= post.id %>"><button>View Details</button></a>
                <br>
                <a href="/posts/<%= post.id %>/edit"><button>Edit</button></a>
                <form action="/posts/<%= post.id %>?_method=DELETE" method="POST" style="display:inline;">
                    <button type="submit">Delete</button    >
                </form>
            </div>
        <% }); %> 
    </div>
    <a href="http://localhost:7777/posts/new"><button>Add New Post</button></a>
</body>
</html>