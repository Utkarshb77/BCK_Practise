<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit chat</title>
</head>
<body>
    <h2>Edit your chat</h2>
    <p>This chat was sent from <%= chat.from %> to <%= chat.to %></p>
    <form action="/chats/<%= chat._id %>?_method=put" method="post">
       <textarea name="message" rows="5" cols="50"><%= chat.message %></textarea>
       <button type="submit">Update</button>
    </form>
</body>
</html>